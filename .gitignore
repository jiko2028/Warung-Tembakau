#####################################################
# Tambahan (aman untuk push ke GitHub)
#####################################################

# Environment variables sensitif
# (.env.example tetap di-commit sebagai template)
.env.*
!.env.example

# Database SQLite - JANGAN di-commit
/database/*.sqlite
/database/*.sqlite-journal
/database/*.sqlite-shm
/database/*.sqlite-wal

# Log tambahan (di luar storage/logs/.gitignore)
*.log

# Sampah OS
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Backup / file swap editor
*.bak
*.orig
*~
*.swp
*.swo

# Cache tooling PHP
.php-cs-fixer.cache

# Debug log package manager
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# File sisa/test (bukan bagian project)
/test_delete.php
